                <TextBlock x:Name="disableReasonHeader" x:Uid="disableReasonHeader" Grid.Row="0" Margin="28 0 5 2" HorizontalAlignment="Stretch" FontWeight="Bold" Text="{Binding Source={x:Static Modern:RibbonLocalization.Current}, Path=Localization.ScreenTipDisableReasonHeader, Mode=OneWay}" TextWrapping="Wrap" />

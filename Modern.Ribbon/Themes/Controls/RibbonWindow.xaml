<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Modern="clr-namespace:Modern"
                    xmlns:controlzex="urn:controlzex"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">
    <ControlTemplate x:Key="Modern.Ribbon.Templates.RibbonWindow"
                     TargetType="{x:Type Modern:RibbonWindow}">
        <Grid LayoutTransform="{Binding LayoutTransform, RelativeSource={RelativeSource TemplatedParent}}"
              RenderTransform="{Binding RenderTransform, RelativeSource={RelativeSource TemplatedParent}}">
            <!-- 底层：内容容器，负责Padding内边距，承载全部UI -->
            <Border x:Name="PART_ContentHost"
                    Padding="{TemplateBinding ContentPadding}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{TemplateBinding Background}"
                    UseLayoutRounding="True">
                <AdornerDecorator x:Name="Adorner">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   Height="{TemplateBinding TitleBarHeight}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   Background="{TemplateBinding TitleBackground}"
                                   LastChildFill="True">
                            <Image x:Name="PART_Icon"
                                   Width="16"
                                   Height="16"
                                   Margin="8 8 0 0"
                                   VerticalAlignment="{TemplateBinding VerticalIconAlignment}"
                                   DockPanel.Dock="Left"
                                   SnapsToDevicePixels="True"
                                   Source="{Modern:IconConverter {Binding Icon, RelativeSource={RelativeSource TemplatedParent}},
                                                                 {Binding RelativeSource={RelativeSource Self}}}"
                                   Stretch="Uniform"
                                   Visibility="{TemplateBinding IsIconVisible, Converter={StaticResource Modern.Ribbon.Converters.BoolToVisibilityConverter}}" />

                            <ContentPresenter x:Name="PART_WindowCommands"
                                              Grid.Row="0"
                                              HorizontalAlignment="Right"
                                              Panel.ZIndex="1"
                                              Content="{TemplateBinding WindowCommands}"
                                              DockPanel.Dock="Right" />

                            <Modern:RibbonTitleBar x:Name="PART_RibbonTitleBar"
                                                  Header="{TemplateBinding Title}"
                                                  VerticalAlignment="Stretch"
                                                  Foreground="{TemplateBinding TitleForeground}"
                                                  IsCollapsed="{TemplateBinding IsCollapsed}" />
                        </DockPanel>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Row="1" />
                    </Grid>
                </AdornerDecorator>
            </Border>

            <!-- 顶层装饰边框，保持原有逻辑：盖在内容最上方，只画边框，背景透明 -->
            <Border x:Name="PART_Border"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{x:Null}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    UseLayoutRounding="True" />

            <ResizeGrip x:Name="WindowResizeGrip"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       controlzex:WindowChrome.ResizeGripDirection="BottomRight"
                       IsTabStop="false"
                       Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="False">
                <Setter TargetName="PART_Border" Property="BorderBrush" Value="{Binding Path=NonActiveBorderBrush, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="PART_Border" Property="BorderBrush" Value="{Binding Path=BorderBrush, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                    <Condition Property="WindowState" Value="Normal" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Border" Property="Visibility" Value="Visible" />
                <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="WindowState" Value="Maximized">
                <!-- 最大化：清除内容容器Padding，内容撑满窗口 -->
                <Setter TargetName="PART_ContentHost" Property="Padding" Value="0" />
                <!-- 只隐藏顶层边框和ResizeGrip，内容容器PART_ContentHost保留显示！ -->
                <Setter TargetName="PART_Border" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Modern.Ribbon.Styles.RibbonWindow"
           TargetType="{x:Type Modern:RibbonWindow}">
        <Setter Property="Background" Value="{DynamicResource Modern.Ribbon.Brushes.RibbonWindow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Modern.Ribbon.Brushes.AccentBase}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaptionColor" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Modern.Ribbon.Brushes.Black}" />
        <Setter Property="GlowColor" Value="{DynamicResource Modern.Ribbon.Colors.AccentBase}" />
        <!-- 彻底移除Window级别Margin，根除黑边来源 -->
        <Setter Property="NonActiveBorderBrush" Value="#434346" />
        <Setter Property="NonActiveGlowColor" Value="#434346" />
        <Setter Property="Template" Value="{StaticResource Modern.Ribbon.Templates.RibbonWindow}" />
        <Setter Property="TitleBackground" Value="{DynamicResource Modern.Ribbon.Brushes.RibbonWindow.TitleBackground}" />
        <Setter Property="TitleBarHeight" Value="34" />
        <Setter Property="TitleForeground" Value="{DynamicResource Modern.Ribbon.Brushes.RibbonWindow.TitleForeground}" />
        <Setter Property="controlzex:WindowBackdropManager.BackdropType" Value="Mica" />
        <Style.Triggers>
            <Trigger Property="UseNativeCaptionButtons" Value="True">
                <Setter Property="GlassFrameThickness" Value="-1" />
            </Trigger>
            <Trigger Property="controlzex:WindowBackdropManager.CurrentBackdropType" Value="Acrylic">
                <Setter Property="Background" Value="{DynamicResource Modern.Ribbon.Brushes.RibbonWindow.Background.Backdrop.Acrylic}" />
                <Setter Property="GlassFrameThickness" Value="-1" />
            </Trigger>
            <Trigger Property="controlzex:WindowBackdropManager.CurrentBackdropType" Value="Auto">
                <Setter Property="Background" Value="{DynamicResource Modern.Ribbon.Brushes.RibbonWindow.Background.Backdrop.Auto}" />
                <Setter Property="GlassFrameThickness" Value="-1" />
            </Trigger>
            <Trigger Property="controlzex:WindowBackdropManager.CurrentBackdropType" Value="Mica">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="GlassFrameThickness" Value="-1" />
            </Trigger>
            <Trigger Property="controlzex:WindowBackdropManager.CurrentBackdropType" Value="Tabbed">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="GlassFrameThickness" Value="-1" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

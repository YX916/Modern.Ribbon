<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Modern="clr-namespace:Modern"
                    xmlns:converters="clr-namespace:Modern.Converters"
                    xmlns:styleSelectors="clr-namespace:Modern.StyleSelectors">
    <ControlTemplate x:Key="Modern.Ribbon.Templates.BackstageTabControl.Button"
                     TargetType="{x:Type Modern:Button}">
        <Border x:Name="rootBorder"
                ToolTip="{TemplateBinding ToolTip}">
            <Grid Background="Transparent">
                <Border x:Name="underlineBorder"
                        Margin="4 8 0 8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="{Binding Path=(Modern:RibbonProperties.IsSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                        BorderThickness="4 0 0 0"
                        Visibility="Collapsed" />

                <StackPanel Margin="25 0 15 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Modern:IconPresenter x:Name="iconImage"
                                          Margin="0 0 8 0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SmallIcon="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                          CustomSize="{Binding Path=(Modern:RibbonProperties.CustomIconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          IconSize="{Binding Path=(Modern:RibbonProperties.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />

                    <ContentControl x:Name="controlLabel"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    Focusable="False">
                        <ContentControl.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </ContentControl.Resources>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="underlineBorder" Property="BorderBrush" Value="{DynamicResource Modern.Ribbon.Brushes.Gray2}" />
                <Setter TargetName="underlineBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="underlineBorder" Property="BorderBrush" Value="{Binding Path=(Modern:RibbonProperties.IsSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="underlineBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource Modern.Ribbon.Brushes.Black}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="beginStoryboardSelectedMouseOver">
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetName="underlineBorder"
                                                Storyboard.TargetProperty="Margin"
                                                To="0"
                                                Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetName="underlineBorder"
                                                Storyboard.TargetProperty="Margin"
                                                Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="controlLabel" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Modern.Ribbon.Styles.BackstageTabControl.Button"
           TargetType="{x:Type Modern:Button}">
        <Setter Property="Modern:RibbonProperties.IconSize" Value="Small" />
        <Setter Property="Modern:RibbonProperties.IsSelectedBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.Selected.Background}" />
        <Setter Property="Modern:RibbonProperties.MouseOverBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.MouseOver.Background}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Modern.Ribbon.Styles.FocusVisual.Empty}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template" Value="{DynamicResource Modern.Ribbon.Templates.BackstageTabControl.Button}" />
    </Style>

    <ControlTemplate x:Key="Modern.Ribbon.Templates.BackstageBackButton"
                     TargetType="Button">
        <Grid x:Name="ContentGrid"
              Background="Transparent"
              Modern:FrameworkHelper.UseLayoutRounding="False">
            <ContentControl Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            Focusable="False">
                <Grid>
                    <Path x:Name="arrowpath"
                          Width="16"
                          Height="12"
                          Data="F1 M 36,22L 36,26L 19.75,26L 27,33L 20.5,33L 11,24L 20.5,15L 27,15L 19.75,22L 36,22 Z "
                          Fill="{TemplateBinding Foreground}"
                          Stretch="Uniform" />

                    <Ellipse x:Name="backellipse"
                             Width="34"
                             Height="34"
                             Stroke="{TemplateBinding Foreground}"
                             StrokeThickness="2" />

                    <Path Margin="0"
                          HorizontalAlignment="Stretch"
                          Data="M0,0 C0,35 0,35 0,35 C0,35 35,35 35,35 L35,0 z"
                          Fill="Transparent"
                          Stretch="None" />
                </Grid>
            </ContentControl>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{Binding Path=(Modern:RibbonProperties.MouseOverForeground), RelativeSource={RelativeSource Self}}" />
                <Setter TargetName="ContentGrid" Property="Background" Value="{Binding Path=(Modern:RibbonProperties.MouseOverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="arrowpath" Property="Opacity" Value="0.8" />
                <Setter TargetName="backellipse" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{Binding Path=(Modern:RibbonProperties.MouseOverForeground), RelativeSource={RelativeSource Self}}" />
                <Setter TargetName="ContentGrid" Property="Background" Value="{Binding Path=(Modern:RibbonProperties.MouseOverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="arrowpath" Property="Opacity" Value="0.8" />
                <Setter TargetName="backellipse" Property="Opacity" Value="0.8" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Modern.Ribbon.Styles.BackstageBackButton"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Modern.Ribbon.Brushes.Backstage.BackButton.Background}" />
        <Setter Property="Modern:RibbonProperties.MouseOverBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.MouseOver.Background}" />
        <Setter Property="Modern:RibbonProperties.MouseOverForeground" Value="{DynamicResource Modern.Ribbon.Brushes.IdealForeground}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Modern.Ribbon.Styles.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Modern.Ribbon.Brushes.Backstage.BackButton.Foreground}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{DynamicResource Modern.Ribbon.Templates.BackstageBackButton}" />
    </Style>

    <Style x:Key="Modern.Ribbon.Styles.BackstageTabControl.SeparatorTabItem"
           TargetType="{x:Type Modern:SeparatorTabItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="25 10 20 10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Modern:SeparatorTabItem}">
                    <StackPanel>
                        <TextBlock x:Name="header"
                                   Margin="10 5"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextWrapping="Wrap"
                                   Visibility="Visible" />
                        <Line Height="1"
                              MinWidth="75"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Modern.Ribbon.Brushes.HighTransparentWhite}"
                              X2="1" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Modern.Ribbon.Templates.BackstageTabControl"
                     TargetType="{x:Type Modern:BackstageTabControl}">
        <ControlTemplate.Resources>
            <ResourceDictionary>
                <Style x:Key="{x:Type Modern:Button}"
                       TargetType="{x:Type Modern:Button}"
                       BasedOn="{StaticResource Modern.Ribbon.Styles.Backstage.Button}" />
                <Style x:Key="{x:Type Modern:ToggleButton}"
                       TargetType="{x:Type Modern:ToggleButton}"
                       BasedOn="{StaticResource Modern.Ribbon.Styles.Backstage.ToggleButton}" />
                <Style x:Key="{x:Type Modern:DropDownButton}"
                       TargetType="{x:Type Modern:DropDownButton}"
                       BasedOn="{StaticResource Modern.Ribbon.Styles.Backstage.DropDownButton}" />
                <Style x:Key="{x:Type Modern:ComboBox}"
                       TargetType="{x:Type Modern:ComboBox}"
                       BasedOn="{StaticResource Modern.Ribbon.Styles.Backstage.ComboBox}" />
            </ResourceDictionary>
        </ControlTemplate.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  MinWidth="{TemplateBinding ItemsPanelMinWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PART_ItemsPanelContainer"
                  VerticalAlignment="Stretch">
                <Grid Background="{TemplateBinding ItemsPanelBackground}"
                      KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="PART_BackButton"
                            Uid="{TemplateBinding BackButtonUid}"
                            Style="{DynamicResource Modern.Ribbon.Styles.BackstageBackButton}"
                            Grid.Row="0"
                            Padding="22 7 0 7"
                            VerticalAlignment="Top"
                            AutomationProperties.AcceleratorKey="ESC"
                            AutomationProperties.Name="{Binding Uid, RelativeSource={RelativeSource Self}}"
                            Command="{x:Static Modern:RibbonCommands.OpenBackstage}"
                            Visibility="{Binding Path=IsBackButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Modern.Ribbon.Converters.BoolToVisibilityConverter}}" />

                    <ItemsPresenter Grid.Row="1" />
                </Grid>
            </Grid>

            <Grid x:Name="PART_SelectedContentGrid"
                  Grid.Column="1"
                  Background="{TemplateBinding Background}">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ContentSource="SelectedContent" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Modern.Ribbon.Styles.BackstageTabControl"
           TargetType="{x:Type Modern:BackstageTabControl}">
        <Setter Property="BackButtonUid" Value="{Binding Source={x:Static Modern:RibbonLocalization.Current}, Path=Localization.BackstageBackButtonUid, Mode=OneWay}" />
        <Setter Property="Background" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabControl.Background}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Modern.Ribbon.Styles.FocusVisual.Empty}" />
        <Setter Property="Foreground" Value="{DynamicResource Modern.Ribbon.Brushes.LabelText}" />
        <Setter Property="ItemContainerStyleSelector" Value="{x:Static styleSelectors:BackstageTabControlItemContainerStyleSelector.Instance}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanelBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabControl.ItemsPanelBackground}" />
        <Setter Property="Margin">
            <Setter.Value>
                <MultiBinding Converter="{x:Static converters:StaticConverters.ThicknessConverter}">
                    <Binding Source="0" />
                    <Binding FallbackValue="0"
                             Path="TitleBar.ActualHeight"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Modern:IRibbonWindow}}" />
                    <Binding Source="0" />
                    <Binding Source="0" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{DynamicResource Modern.Ribbon.Templates.BackstageTabControl}" />
    </Style>
</ResourceDictionary>
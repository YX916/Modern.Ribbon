<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Modern="clr-namespace:Modern"
                    xmlns:converters="clr-namespace:Modern.Converters">
    <ControlTemplate x:Key="Modern.Ribbon.Templates.BackstageTabItem"
                     TargetType="{x:Type Modern:BackstageTabItem}">
        <Border x:Name="rootBorder"
                Background="Transparent"
                ToolTip="{TemplateBinding ToolTip}">
            <Grid x:Name="rootGrid">
                <StackPanel Margin="25 0 15 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Modern:IconPresenter x:Name="iconImage"
                                          Margin="0 0 8 0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SmallIcon="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                          CustomSize="{Binding Path=(Modern:RibbonProperties.CustomIconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          IconSize="{Binding Path=(Modern:RibbonProperties.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />

                    <ContentControl x:Name="PART_Header"
                                    Foreground="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.Header.Foreground}"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                    Focusable="False">
                        <ContentControl.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </ContentControl.Resources>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Header" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="rootBorder" Property="Background" Value="{Binding Path=(Modern:RibbonProperties.MouseOverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter TargetName="rootBorder" Property="Background" Value="{Binding Path=(Modern:RibbonProperties.IsSelectedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Modern.Ribbon.Styles.BackstageTabItem"
           TargetType="{x:Type Modern:BackstageTabItem}">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Modern:BackstageTabControl}}}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Modern.Ribbon.Styles.FocusVisual.Empty}" />
        <Setter Property="Foreground" Value="{DynamicResource Modern.Ribbon.Brushes.Black}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Modern:RibbonProperties.IsSelectedBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.Selected.Background}" />
        <Setter Property="Modern:RibbonProperties.MouseOverBackground" Value="{DynamicResource Modern.Ribbon.Brushes.BackstageTabItem.MouseOver.Background}" />
        <Setter Property="Template" Value="{DynamicResource Modern.Ribbon.Templates.BackstageTabItem}" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
    </Style>
</ResourceDictionary>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Modern</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Platforms>x64</Platforms>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Themes\Effects\Grayscale.ps" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="XAMLTools.MSBuild" Version="1.0.0-alpha.189">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<FilesForXamlCombine>Themes\Controls\*.xaml;Themes\Common.xaml</FilesForXamlCombine>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Modern.Ribbon.Additional\Modern.Ribbon.Additional.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Themes\Effects\Grayscale.ps" />
	</ItemGroup>
	<ItemGroup>
		<XAMLCombineItems Include="$(FilesForXamlCombine)">
			<TargetFile>Themes\Styles.xaml</TargetFile>
			<Visible>False</Visible>
		</XAMLCombineItems>
	</ItemGroup>
</Project>
